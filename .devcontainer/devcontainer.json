{
  "name": "azure-migration-orchestrator",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26-trixie",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "npm ci && npm run build",
  "forwardPorts": [8080],
  "customizations": { "vscode": { "extensions": ["hashicorp.terraform", "ms-vscode.powershell", "dbaeumer.vscode-eslint", "GitHub.copilot"] } }
}
