# Azure Migration Orchestrator — example environment. Copy to .env (git-ignored). Never put secrets here.
# Authentication uses managed identity or workload identity federation. Any variable ending in SECRET or PASSWORD makes the API refuse to start.
PORT=8081
AMO_LOG_SILENT=0
# Rules are found automatically (rules/ in this repository, or inside the published package). Override only for testing.
AMO_RULES_DIR=

AMO_ENTRA_TENANT_ID=
AMO_ENTRA_CLIENT_ID=
AMO_ENTRA_AUDIENCE=
# Browser origins allowed to call the API from a different address (ADR-0033): comma-separated exact origins (https://..., or http:// only for localhost, 127.0.0.1 or [::1]), no path, no trailing slash, no wildcard. Empty (default) = no CORS headers, for a web UI on the same address.
AMO_ALLOWED_ORIGINS=
# Host names the API answers, against DNS rebinding (a web page on another site making your browser call the API on your own machine under its own name): comma-separated host or host:port values, lower case, no scheme, no path, no wildcard. Empty (default) = any Host is served, which is right in Azure. docker-compose.appliance.yml sets localhost:8081,127.0.0.1:8081,[::1]:8081 for local use.
AMO_ALLOWED_HOSTS=
AMO_CREDENTIAL_KIND=managed-identity
AMO_DISCOVERY_FIXTURE=0

# Leave empty for the session-only in-memory repository (first release). Azure Database for PostgreSQL uses Entra token auth; password URLs are refused.
DATABASE_URL=
