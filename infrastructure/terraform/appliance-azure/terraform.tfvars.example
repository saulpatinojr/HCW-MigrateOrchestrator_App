tenant_id            = "00000000-0000-0000-0000-000000000000"
assessment_scope_ids = ["/subscriptions/00000000-0000-0000-0000-000000000000"]
# Required, and deliberately not set here: image_ref, the appliance image by exact digest. Copy the line that ends the
# publish-images run summary (docker.io/hybridcloudworks/img-mo-appliance-app@sha256: followed by 64 hexadecimal
# characters) and pass it as shown in docs/deployment/enterprise.md. Tags such as :latest are refused.
# Optional. Who may reach the API over HTTPS: ["Internet"] (default) or a list of CIDR ranges, for example your office or VPN.
# ingress_allowed_source_prefixes = ["203.0.113.0/24"]
# Optional, costs money, can only be chosen before the first apply (ADR-0032). Leave it off unless you have decided.
# postgres_geo_redundant_backup_enabled = true
# Optional. Assign app roles here or in the Entra portal. Pass it with TF_VAR_app_role_assignments instead of a file if you
# prefer (docs/deployment/enterprise.md, section 2).
# app_role_assignments = { admin = { principal_object_id = "00000000-0000-0000-0000-000000000000", role = "Migration.Execute" } }
