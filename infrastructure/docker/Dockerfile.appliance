# syntax=docker/dockerfile:1.7
# Both base images are pinned by digest (tag@sha256:...); Dependabot (docker ecosystem) proposes updates.
# Base: node:26-trixie-slim (Debian 13), the multi-arch index digest read from Docker Hub on 2026-11-13: Node 26.13.1 (NODE_VERSION
# in the linux/amd64 image config), Node's 2026-11-11 security release; the 26.13.1-trixie-slim tag resolves to the same digest.
# Moved from node:26-bookworm-slim (Debian 12), whose apt 2.6.1 carries CVE-2026-109518. Change both FROM lines together;
# tests/security/base-image-pins.test.mjs pins the shape.
# Azure Migration Orchestrator — appliance API + worker. Managed identity / WIF only; no client secrets accepted at startup.
# Single-repository build (ADR-0028): the engine, rules and appliance all live here.
FROM node:26-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc AS build
WORKDIR /src
COPY package.json package-lock.json tsconfig.base.json tsconfig.build.json ./
COPY packages ./packages
COPY apps ./apps
# tsc -b --force: stale *.tsbuildinfo in a build context must never suppress emission.
RUN npm ci --no-audit --no-fund && npx tsc -b tsconfig.build.json --force && npm prune --omit=dev

FROM node:26-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc
ENV NODE_ENV=production PORT=8081 AMO_RULES_DIR=/app/rules AMO_CREDENTIAL_KIND=managed-identity
WORKDIR /app
# Debian's security updates on top of the digest-pinned base (Trivy gates publication on fixed HIGH/CRITICAL CVEs). A security
# upload reaches the mirrors days before the official Node image is rebuilt with it; this step closes that window.
# `Acquire::Retries=0`: the apt doing this upgrade is still the base's, and CVE-2026-109518 needs a download retry to slip an
# unverified package in, so retries stay off (a mirror hiccup fails the build instead).
# `--error-on=any`: the update fails if any index (the security one above all) cannot be fetched, instead of succeeding with a
# warning and leaving the base unupgraded. PUBLISH_CACHE_BUST is a per-run value publish-images.yml passes (run id and attempt);
# naming it in the command gives this layer a new cache key on every publish run, so a rebuild never reuses an older upgrade
# result. Unset on a local or CI build, where the layer caches as usual.
ARG PUBLISH_CACHE_BUST=
RUN printf 'upgrade run: %s\n' "${PUBLISH_CACHE_BUST}" \
    && apt-get -o Acquire::Retries=0 update --error-on=any \
    && apt-get -o Acquire::Retries=0 upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/packages ./packages
COPY --from=build /src/apps/appliance-api ./apps/appliance-api
COPY --from=build /src/apps/worker ./apps/worker
COPY --from=build /src/package.json ./
COPY rules ./rules
# The runtime needs node only: drop the bundled npm/npx/corepack (and their CVE surface), sources and the browser-only UI package.
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
 && rm -rf packages/*/src apps/*/src packages/ui && chown -R node:node /app
USER node
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8081/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/appliance-api/dist/server.js"]
